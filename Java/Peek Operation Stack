class Stack {
    int[] arr = new int[5];
    int top = -1;

    void push(int x) {
        arr[++top] = x;
    }

    void peek() {
        if (top == -1)
            System.out.println("Stack is Empty");
        else
            System.out.println(arr[top]);
    }
}

public class Main {
    public static void main(String[] args) {
        Stack s = new Stack();

        s.push(10);
        s.push(20);
        s.push(30);

        s.peek();
    }
}
